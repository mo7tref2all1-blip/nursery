NODE_ENV=production
PORT=3001

# ─── MySQL (اعدادات قاعدة البيانات) ───
# نفس البيانات اللي بتظهر في cPanel → MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpanel_username_dbuser
DB_PASS=your_db_password
DB_NAME=cpanel_username_nursery

# ─── JWT Secret ───
# غير الكلمة دي لأي نص عشوائي طويل
JWT_SECRET=change_this_to_a_long_random_secret
